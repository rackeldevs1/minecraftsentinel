# Optional. Everything here can also be set directly in src/settings.js.
# Values set in the environment always win.
#
# Copy to .env and load it however you like (`--env-file=.env` on Node 20+):
#   node --env-file=.env src/index.js
#
# .env is gitignored. Never commit real values.

# ── required ────────────────────────────────────────────────────────────────
BW_ADMINS=YourMinecraftName
BW_WEBHOOK_URL=https://discord.com/api/webhooks/000000000/xxxxxxxx
BW_MC_USERNAME=YourBotsMinecraftName
BW_MC_PASSWORD=your-authme-password

# ── server ──────────────────────────────────────────────────────────────────
# BW_HOST=play.6b6t.org
# BW_HOSTS=play.6b6t.org,alt.6b6t.org,alt2.6b6t.org,alt3.6b6t.org
# BW_PORT=25565
# BW_VERSION=1.20.4
# BW_VIEW_DISTANCE=8

# ── watching ────────────────────────────────────────────────────────────────
# BW_SCAN_RADIUS=128
# BW_CLOSE_RADIUS=32
# BW_CLOSE_REPEAT_MS=300000
# BW_FAR_COOLDOWN_MS=3600000
# BW_IGNORE=SomeFriend,AnotherFriend

# ── spawn mute (see the README) ─────────────────────────────────────────────
# BW_SPAWN_RADIUS=5000
# BW_SPAWN_X=0
# BW_SPAWN_Z=0

# ── extras ──────────────────────────────────────────────────────────────────
# BW_DISCORD_PING=<@123456789012345678>
# BW_PREFIX=?
# BW_ANTI_AFK=true
# BW_CHAT_DEBUG=false
# BW_WATCH_DEBUG=false

# ── SOCKS5 proxy, if you need one ───────────────────────────────────────────
# BW_PROXY_ENABLED=true
# BW_PROXY_HOST=127.0.0.1
# BW_PROXY_PORT=1080
# BW_PROXY_USERNAME=
# BW_PROXY_PASSWORD=
